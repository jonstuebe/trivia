{
  "name": "trivia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "bun run check-content && vite build",
    "build:fixtures": "bun run check-fixtures && vite build --mode fixtures",
    "check-content": "bun scripts/check-content.ts",
    "check-fixtures": "bun scripts/check-content.ts --content src/content/fixtures --out src/content/topic-index.fixtures.gen.json",
    "assign-ids": "bun scripts/assign-ids.ts",
    "preview": "vite preview",
    "lint": "oxlint --disable-nested-config",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "E2E_TELEMETRY_DISABLED=1 e2e run"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "e2e": "0.21.3",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  }
}
